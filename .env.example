# Note: If passwords (INIT_PASSWORD, DATABASE_PASSWORD) or keys contain special characters
# like $ or #, enclose the value in single quotes (e.g. INIT_PASSWORD='my$ecurePassword').
# This prevents Docker Compose and environment loaders from misinterpreting $ as variable substitution.

# TIR server (required)
SECRET_KEY= # Required: Secret key for session/token signing
INIT_PASSWORD= # Required: Initial Password for initial TIR admin Account

# Optional: Dev Web Server Port Defaults to 3000
# PORT=3000

# SQLite config (Default)
SQLITE=true

# Postgres config (Set SQLITE=false to use Postgres)
# DATABASE_HOST= # Required: Postgres Database IP/FQDN
# DATABASE_PORT=5432 # Optional: Defaults to 5432
# DATABASE_USER= # Required: Postgres User
# DATABASE_PASSWORD= # Required: Postgres User Password
# DATABASE_NAME= # Required: Database Name for TIR
